<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude local IndexedDB, WebView cache, and shared prefs so family profiles & billing tokens stay strictly device-local unless explicitly exported via .ilmizo-sync -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="app_webview/" />
</full-backup-content>
